#!/bin/bash
# Send files from the server to the Mac's ~/Downloads over Taildrop.
#   tomac report.html plot.png some-folder/      (folders go as .zip)
set -u
MAC=${TOMAC_PEER:-@MAC@}     # filled in by install.sh
[ $# -gt 0 ] || { echo "usage: tomac FILE..." >&2; exit 2; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

files=()
for src in "$@"; do
    src=${src%/}
    if [ -d "$src" ]; then
        zip="$tmp/$(basename "$src").zip"
        (cd "$(dirname "$src")" && python3 -m zipfile -c "$zip" "$(basename "$src")") || exit 1
        files+=("$zip")
    else
        files+=("$src")
    fi
done
tailscale file cp "${files[@]}" "$MAC:" && echo "sent ${#files[@]} file(s) to $MAC"
